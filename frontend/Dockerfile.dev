FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# App sources are copied explicitly (never `COPY . .`) so dev artifacts —
# lint logs, screenshots, pytest output — cannot leak into the image.
COPY next.config.ts tsconfig.json next-env.d.ts postcss.config.mjs eslint.config.mjs ./
COPY instrumentation.ts instrumentation-client.ts capacitor.config.ts ./
COPY src/ ./src/
COPY public/ ./public/

# Pre-create the dirs compose mounts anonymous volumes on, owned by the dev
# user, so `next dev` can write .next without root.
RUN mkdir -p /app/.next && chown -R node:node /app
USER node

EXPOSE 3000

CMD ["npx", "next", "dev", "--webpack", "-p", "3000"]
