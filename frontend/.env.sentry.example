# Sentry frontend (Next.js) — copy real values into .env.production / CI secrets
# Everything is optional: without these vars the app ships Sentry-free.

# Browser (exposed to the client — safe: only a write-limited event ingestion key)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Set to "true" to enable session replay on error pages
NEXT_PUBLIC_SENTRY_REPLAY=false

# Server (Node runtime — instrumentation.ts)
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# CI only — enables source-map upload + release creation during next build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
