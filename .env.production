# Application
ENV=production
DEBUG=false
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database - MUST use PostgreSQL in production
DATABASE_URL=postgresql://market:${POSTGRES_PASSWORD}@postgres:5432/market

# Redis
REDIS_URL=redis://redis:6379/0

# Security - MUST CHANGE
SECRET_KEY=${SECRET_KEY}
API_KEY_HEADER=X-API-Key

# CORS - MUST restrict to actual domains
CORS_ORIGINS=["https://yourdomain.com"]

# Providers
TSETMC_BASE_URL=http://tsetmc.com
CODAL_BASE_URL=https://codal.ir

# Data & Storage
DATA_DIR=/app/data
ML_MODEL_DIR=/app/data/models

# Backtesting
BACKTEST_DEFAULT_CAPITAL=1000000000
BACKTEST_DEFAULT_COMMISSION_PCT=0.0035
BACKTEST_DEFAULT_SLIPPAGE_BPS=10.0

# Provider settings
PROVIDER_DEFAULT_TIMEOUT=30
PROVIDER_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_PER_MINUTE=60

# Scheduler
SCHEDULER_TIMEZONE=Asia/Tehran

# Observability
OTLP_ENDPOINT=http://otel-collector:4318
# SENTRY_DSN=https://key@sentry.io/project
BRSAPI_GLOBAL_DAILY_LIMIT=4000
BRSAPI_ENABLED=false  # DB-only until the server-side counter resets
