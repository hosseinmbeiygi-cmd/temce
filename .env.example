# ==============================================
#  تنظیمات عمومی برنامه (Application)
# ==============================================
ENV=development                     # development | production | staging
DEBUG=true
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console

# ==============================================
#  تنظیمات سرور (Server)
# ==============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==============================================
#  تنظیمات دیتابیس (PostgreSQL) - برای تولید الزامی است
# ==============================================
# آدرس کامل اتصال (برای SQLAlchemy، Alembic، و غیره)
DATABASE_URL=postgresql://hossein:1343@localhost:5432/my_first_db

# اطلاعات اتصال به‌صورت جداگانه (برای استفاده با psycopg2 یا سایر کتابخانه‌ها)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_first_db
DB_USER=hossein
DB_PASSWORD=1343

# تنظیمات مربوط به Connection Pool (اختیاری)
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30

# ==============================================
#  تنظیمات Redis (برای کش، Queue و Session)
# ==============================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# ==============================================
#  تنظیمات امنیتی (Security) - در تولید حتماً تغییر دهید
# ==============================================
SECRET_KEY=change-me-in-production-use-strong-random-key
ALGORITHM=HS256                           # یا RS256 برای غیرمتقارن
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER=X-API-Key

# ==============================================
#  تنظیمات CORS - در تولید دقیقاً تعیین کنید
# ==============================================
CORS_ORIGINS=["*"]                       # برای تولید: ["https://domain.com", "https://www.domain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ==============================================
#  تنظیمات سرویس‌های خارجی (Provider)
# ==============================================
TSETMC_BASE_URL=http://tsetmc.com
CODAL_BASE_URL=https://codal.ir

PROVIDER_DEFAULT_TIMEOUT=30              # ثانیه
PROVIDER_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_PER_MINUTE=60

# ==============================================
#  تنظیمات مسیرهای داده و مدل
# ==============================================
DATA_DIR=./data
ML_MODEL_DIR=./data/models
TEMP_DIR=./tmp
UPLOAD_DIR=./uploads

# ==============================================
#  تنظیمات Backtesting (آزمایش استراتژی)
# ==============================================
BACKTEST_DEFAULT_CAPITAL=1000000000      # سرمایه اولیه به ریال
BACKTEST_DEFAULT_COMMISSION_PCT=0.0035   # 0.35% کارمزد
BACKTEST_DEFAULT_SLIPPAGE_BPS=10.0       # 10 واحد پایه (0.1%)
BACKTEST_DEFAULT_START_DATE=2024-01-01
BACKTEST_DEFAULT_END_DATE=2025-12-31

# ==============================================
#  تنظیمات زمانبندی (Scheduler - APScheduler)
# ==============================================
SCHEDULER_TIMEZONE=Asia/Tehran
SCHEDULER_JOB_STORE=memory               # memory | redis | mongodb
SCHEDULER_DEFAULT_INTERVAL_MINUTES=5

# ==============================================
#  تنظیمات مرتبط با وظایف خاص (Custom Jobs)
# ==============================================
UPDATE_MARKET_DATA_CRON=0 8 * * *        # هر روز ساعت ۸ صبح
UPDATE_SYMBOLS_CRON=0 1 * * *            # هر روز ساعت ۱ بامداد
CLEANUP_TEMP_FILES_CRON=0 4 * * *        # هر روز ساعت ۴ صبح

# ==============================================
#  تنظیمات ارسال ایمیل (در صورت نیاز)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ==============================================
#  تنظیمات مانیتورینگ و ابزارهای رصد (اختیاری)
# ==============================================
OTLP_ENDPOINT=http://otel-collector:4318   # برای OpenTelemetry
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ==============================================
#  تنظیمات ویژه (Feature Flags)
# ==============================================
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_REALTIME_WEBSOCKET=true
ENABLE_BACKTESTING=true

# ==============================================
#  تنظیمات پیش‌فرض صفحه‌بندی (Pagination)
# ==============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=150

# ==============================================
#  تنظیمات رمزنگاری (در صورت نیاز)
# ==============================================
ENCRYPTION_KEY=change-me-in-production    # کلید ۳۲ بایتی برای AES

# ==============================================
#  تنظیمات BrsApi | https://brsapi.ir
# ==============================================
# کلید API (دریافت رایگان از سایت BrsApi)
BRSAPI_API_KEY=Bk7JvdJZBHJ9DMhzeuTfWjwqYy1wMsif
# آدرس پایه (تغییر ندهید)
BRSAPI_BASE_URL=https://Api.BrsApi.ir
# Timeout درخواست (ثانیه)
BRSAPI_REQUEST_TIMEOUT=30
# حداکثر تلاش مجدد
BRSAPI_MAX_RETRIES=3
# فعال/غیرفعال کردن Redis cache
BRSAPI_CACHE_ENABLED=true
# TTL پیش‌فرض کش
BRSAPI_CACHE_TTL_DEFAULT=55
# فقط در ساعات بازار فعال باشد؟
BRSAPI_ONLY_DURING_MARKET_HOURS=true
# منطقه زمانی بازار
BRSAPI_MARKET_TIMEZONE=Asia/Tehran
# ساعت شروع بازار
BRSAPI_MARKET_OPEN=08:30
# ساعت پایان بازار
BRSAPI_MARKET_CLOSE=15:30
# محدودیت نرخ درخواست (تعداد در دقیقه)
# TSETMC: 30 req/min | CODAL: 20 | IME: 15 | Commodity: 15 | Crypto: 15
BRSAPI_RATE_LIMIT_TSETMC=30
BRSAPI_RATE_LIMIT_CODAL=20
BRSAPI_RATE_LIMIT_IME=15
BRSAPI_RATE_LIMIT_COMMODITY=15
BRSAPI_RATE_LIMIT_CRYPTO=15
# ذخیره‌سازی خام JSON برای حسابرسی
BRSAPI_RAW_PAYLOAD_SINK_ENABLED=false
# حداکثر سن داده‌های خام (روز)
BRSAPI_MAX_RAW_PAYLOAD_AGE_DAYS=30