# Application
ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database - use PostgreSQL for production
# DATABASE_URL=postgresql://user:password@host:5432/market
DATABASE_URL=sqlite:///data/market.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# CORS - restrict in production
# CORS_ORIGINS=["https://yourdomain.com"]
CORS_ORIGINS=["*"]

# Providers
TSETMC_BASE_URL=http://tsetmc.com
CODAL_BASE_URL=https://codal.ir

# Data & Storage
DATA_DIR=./data
ML_MODEL_DIR=./data/models

# Backtesting defaults
BACKTEST_DEFAULT_CAPITAL=1000000000
BACKTEST_DEFAULT_COMMISSION_PCT=0.0035
BACKTEST_DEFAULT_SLIPPAGE_BPS=10.0

# Provider settings
PROVIDER_DEFAULT_TIMEOUT=30
PROVIDER_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_PER_MINUTE=60

# Scheduler
SCHEDULER_TIMEZONE=Asia/Tehran

# Observability (optional)
# OTLP_ENDPOINT=http://otel-collector:4318
# SENTRY_DSN=https://key@sentry.io/project
