# ── Decision Engine Dockerfile ─────────────────────────────────
# Standalone microservice for the Decision Engine (سامانه تصمیم‌یار)
#
# Part of the 22-service architecture:
#   - Category: processor
#   - Depends on: risk-engine-service
#   - Protocol: Internal Queue + REST API
#   - Data dest: score_final_results, decision_reports
#
# Build:
#   docker build -t decision-engine -f Dockerfile.decision-engine .
#
# Run:
#   docker run -p 8002:8002 --env-file .env decision-engine
#
# With docker compose (add to docker-compose.yml):
#   decision-engine:
#     build:
#       context: .
#       dockerfile: Dockerfile.decision-engine
#     container_name: tse_decision_engine
#     depends_on:
#       timescaledb:
#         condition: service_healthy
#       redis:
#         condition: service_started
#     ports:
#       - "8002:8002"
#     environment:
#       - DECISION_ENGINE_PORT=8002
#     restart: always

FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system app \
    && adduser --system --ingroup app --home /app --disabled-password app

WORKDIR /app

COPY --from=builder /root/.local /home/app/.local
ENV PATH=/home/app/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --chown=app:app . .

EXPOSE 8002

USER app

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health', timeout=5)" || exit 1

CMD ["uvicorn", "apps.decision_engine.app:app", "--host", "0.0.0.0", "--port", "8002"]
