  L  90  پله 1: اگر حباب < threshold → خرید
  L  91  پله 2: اگر قیمت از خرید قبلی 3-5% اصلاح → خرید
  L  92  پله 3: در آخرین روز → خرید
  L  94  if len(closes) < 10:
  L  99  capital_remaining = 1.0  # نرمال‌شده
  L 102  cutoffs = [n_days // 3, 2 * n_days // 3, n_days - 1]
  L 106  if tranche_idx == 0:
  L 108  avg30 = np.mean([c for _, c in closes[max(0, cutoff - 30) : cutoff + 1]])
  L 109  bubble = (price - avg30) / avg30 * 100
  L 111  elif tranche_idx == 1 and last_buy_price:
  L 113  change_pct = (price - last_buy_price) / last_buy_price * 100
  L 114  trigger_met = -5 < change_pct < -3
  L 121  units = amount / price if price > 0 else 0
  L 125  tranche=tranche_idx + 1,
  L 145  period_start=closes[0][0] if closes else date.today(),
  L 146  period_end=closes[-1][0] if closes else date.today(),
