  L 163  sma200 = _sma(prices, 200)
  L 165  entry_idx = 0
  L 166  for i in range(200, len(prices)):
  L 167  if not in_pos and sma50[i] > sma200[i] and sma50[i - 1] <= sma200[i - 1]:
  L 170  elif in_pos and sma50[i] < sma200[i] and sma50[i - 1] >= sma200[i - 1]:
  L 172  ret = (prices[i] - prices[entry_idx]) / prices[entry_idx] * 100
  L 178  prices: list[float], dates: list[datetime], threshold: float = 5.0
