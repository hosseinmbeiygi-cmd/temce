  L  88  def _rsi(prices: list[float], period: int = 14) -> list[float]:
  L  90  if len(prices) < period + 1:
  L  91  return [50.0] * len(prices)
  L  95  gains = np.where(deltas > 0, deltas, 0)
  L  96  losses = np.where(deltas < 0, -deltas, 0)
  L  98  rsis = [50.0] * len(prices)
  L 102  if avg_loss == 0:
  L 103  rsis[period] = 100.0
  L 105  rsis[period] = 100 - (100 / (1 + avg_gain / avg_loss))
  L 107  for i in range(period + 1, len(prices)):
  L 108  g = gains[i - 1] if i - 1 < len(gains) else 0
  L 109  l = losses[i - 1] if i - 1 < len(losses) else 0
  L 110  avg_gain = (avg_gain * (period - 1) + g) / period
  L 111  avg_loss = (avg_loss * (period - 1) + l) / period
  L 112  if avg_loss == 0:
  L 113  rsis[i] = 100
  L 115  rsis[i] = 100 - (100 / (1 + avg_gain / avg_loss))
  L 123  return [prices[0] if prices else 0] * len(prices)
  L 126  if i < period - 1:
  L 127  out.append(sum(prices[: i + 1]) / (i + 1))
  L 129  out.append(sum(prices[i - period + 1 : i + 1]) / period)
  L 137  """خرید وقتی RSI < 30، فروش وقتی RSI > 70. Returns: (entry_idx, exit_idx, return_pct)."""
  L 139  rsi = _rsi(prices, 14)
  L 140  i = 0
  L 141  while i < len(prices) - 1:
  L 142  if rsi[i] < 30:
  L 145  exit_idx = i + 30
  L 146  for j in range(i + 1, min(i + 30, len(prices))):
  L 147  if rsi[j] > 70:
  L 151  ret = (prices[exit_idx] - entry) / entry * 100
  L 153  i = exit_idx + 1
  L 155  i += 1
  L 160  """خرید وقتی SMA 50 > SMA 200 (Golden Cross)."""
