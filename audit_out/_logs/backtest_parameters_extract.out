  L 160  start_date = closes[0][0]
  L 161  end_date = closes[-1][0]
  L 162  start_price = closes[0][1]
  L 163  end_price = closes[-1][1]
  L 169  total_return = (final_value / initial_capital - 1) * 100 if initial_capital > 0 else 0
  L 170  bh_return = (end_price / start_price - 1) * 100
  L 174  successful = sum(1 for t in trades if t.price < end_price)
  L 176  hit_rate = (successful / n * 100) if n else 0
  L 183  drawdown = (peak - portfolio) / peak * 100
  L 184  max_dd = float(np.max(drawdown)) if len(drawdown) > 0 else 0
  L 187  if len(closes) > 2:
  L 190  daily_returns = (prices[1:] - prices[:-1]) / prices[:-1]
  L 191  if len(daily_returns) > 1 and np.std(daily_returns) > 1e-9:
  L 192  sharpe = float(np.sqrt(252) * np.mean(daily_returns) / np.std(daily_returns))
  L 194  sharpe = 0.0
  L 196  sharpe = 0.0
  L 199  if n < 3:
  L 207  total_return_pct=round(total_return, 2),
  L 208  buy_hold_return_pct=round(bh_return, 2),
  L 209  alpha_pct=round(alpha, 2),
  L 210  hit_rate_pct=round(hit_rate, 1),
  L 213  max_drawdown_pct=round(max_dd, 2),
  L 214  sharpe_ratio=round(sharpe, 2),
