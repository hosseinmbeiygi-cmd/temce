# ── Dependencies ──────────────────────────
node_modules/
frontend/node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Build artifacts ──────────────────────
.next/
frontend/.next/
dist/
build/
*.egg-info/
*.egg
*.whl

# ── Local development ────────────────────
# `.env.*` is deliberately broad: the build context is what Docker can copy,
# so every local secret variant must be excluded here even though the current
# Dockerfiles copy explicit paths. The narrower `.env` / `.env.*.local` pair
# left real local files such as `.env.production` and `.env.bak.*` exposed.
.env
.env.*
*.env
data/
logs/
tmp/

# ── IDE & Editor ─────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Git ──────────────────────────────────
.git/
.gitignore
.gitattributes
.gitmodules

# ── Testing & Coverage ───────────────────
.coverage
coverage/
.coverage.*
coverage.xml
*.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.mypy/

# ── Docker ───────────────────────────────
docker-compose*.yml
Dockerfile*
!Dockerfile.frontend
!Dockerfile.api
!Dockerfile.admin
!Dockerfile.worker
!Dockerfile
!Dockerfile.decision-engine
frontend/Dockerfile.dev

# ── Documentation ────────────────────────
*.md
!README.md
docs/
assets/
*.pdf
*.png
*.jpg
*.svg
!frontend/public/

# ── CI/CD ────────────────────────────────
.github/

# ── Secrets & Config ─────────────────────
secrets/
config/local.yaml
*.pem
*.key

# ── Dev artifacts & runtime state ────────
# Not needed by any image; kept out of the context so an accidental
# wholesale copy cannot ship test suites or local databases.
tests/
precompute/tests/
test_results/
unit_scan_logs/
audit_out/
code_dump/
_FRONTEND_BACKEND_COPY/
ML_ALL_CODE.txt
*.db
*.rdb

# ── Backups & artifacts ──────────────────
backups/
*.sql
*.sql.gz
*.tar.gz
*.zip
