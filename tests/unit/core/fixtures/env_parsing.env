# Fixture .env used by tests/unit/core/test_settings_env.py.
# It deliberately reproduces the patterns found in the repository's real .env:
#   * a JSON list value followed by an inline # comment,
#   * an inline comment after a plain scalar,
#   * a single-quoted value.
ENV=staging                             # development | production | staging
DEBUG=true
SECRET_KEY="quoted-secret-key"          # inline comment
CORS_ORIGINS=["https://app.example", "https://www.example"]   # trailing comment
DATABASE_URL=postgresql://user:pw@localhost:5432/market   # inline comment
ML_MODEL_DIR=./ml_artifacts             # artifacts root
AUTH_DISABLED=false
DEFAULT_CURRENCY=TOMAN
