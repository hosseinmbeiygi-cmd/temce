# Dockerfile.golddesk — production image for GoldDesk service
# Builds alongside the main backend (shares python deps)
# Runs only GoldDesk scheduler jobs in a focused worker

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App code
COPY . .

# Healthcheck: hit GoldDesk health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8000/api/gold/health || exit 1

# Default: run only GoldDesk scheduler jobs
CMD ["python", "-m", "apps.scheduler.app", "--only", "gold_desk"]
